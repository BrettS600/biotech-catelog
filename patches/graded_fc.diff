+.al.fc.folded #fcg-side { display:none; }
+#fcg-main { min-width:0; }
+#fcg .wrap { overflow:auto; max-height:calc(100vh - 90px); border:1px solid var(--line); border-radius:8px; }
+#fcg-main .fc-unfold { float:right; }
+.fcg-gmode { padding:4px 0 8px; }
+#fcg .controls, #fcg .ranges { padding-left:0; padding-right:0; }
+td.fcg2 > span { display:block; white-space:nowrap; line-height:1.35; }
+td.fcg2 i { font-style:normal; font-size:10px; color:var(--muted); margin-right:4px; }
+tr.fcg-buy > td { font-weight:600; }
+button.gplb { font:inherit; font-size:15px; font-weight:700; line-height:1; width:22px; height:22px; padding:0; border:1px solid var(--line); border-radius:6px; background:var(--head); color:var(--muted); cursor:pointer; }
+button.gplb:hover { color:var(--fg); border-color:var(--link); }
+button.gplb.on { background:var(--up); border-color:var(--up); color:#fff; }
