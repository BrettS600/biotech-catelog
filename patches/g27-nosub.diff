+    used = False
+    for m in range(max(cov or 0, m0), now):
+        k = m - m0
+        if k >= len(v):
+            break
+        pro, cnt = v[k] or 0, vis.get(m, 0)
+        if not pro and not cnt:
+            continue
+        used = True
+        _vcheck["n"] += 1
+        _vcheck["exact"] += pro == cnt
+        _vcheck["near"] += abs(pro - cnt) <= max(1, 0.1 * pro)
+        _vcheck["pro"] += pro
+        _vcheck["cnt"] += cnt
+    _vcheck["cards"] += used
+
