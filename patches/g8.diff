+.gdtools #gdrestore.arm { border-color:var(--down); color:var(--down); }
+.gdbody { flex:1 1 auto; overflow:auto; padding:6px 10px 24px; outline:none; font-size:14px; line-height:1.6; }
+.gdbody:focus { box-shadow:inset 0 0 0 1px color-mix(in srgb, var(--link) 35%, transparent); border-radius:6px; }
