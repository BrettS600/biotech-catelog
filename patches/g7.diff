+        by = {str(ym)[:7]: p for ym, p in v}
+        first, last = min(by), max(by)
+        y, m = int(first[:4]), int(first[5:7])
+        vals = []
+        while f"{y}-{m:02d}" <= last:
+            p = by.get(f"{y}-{m:02d}")
+            vals.append(None if p is None else round(float(p), 2))
+            m += 1
+            if m > 12:
+                y, m = y + 1, 1
+        out[c] = [first, vals]
+    return out
+
