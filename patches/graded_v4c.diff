+            A2, B2 = A - DEFAULT_SPECIAL, B - DEFAULT_SPECIAL
+            out[key] = [", ".join(sorted(A)), ", ".join(sorted(B)), "both_none" if not A2 and not B2 else ("match" if A2 == B2 else "mismatch")]
